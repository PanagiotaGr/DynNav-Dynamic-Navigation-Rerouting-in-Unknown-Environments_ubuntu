<?xml version="1.0"?>
<package format="3">
  <name>dynnav_turtlebot3</name>
  <version>0.1.0</version>

  <description>DynNav TurtleBot3 Gazebo and Nav2 integration package for ROS 2 Jazzy.</description>

  <maintainer email="75089541+panagiotagrosdouli@users.noreply.github.com">Panagiota Grosdouli</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_python</depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>dynnav_bringup</exec_depend>
  <exec_depend>dynnav_nav2_cpp</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
